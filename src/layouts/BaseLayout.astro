---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'ごまの制作物と日々の記録を置く個人サイトです。',
} = Astro.props;

const navigation = [
	{ label: '/now', href: '/now/' },
	{ label: '/til', href: '/tils/' },
	{ label: '/works', href: '/#works-heading' },
	{ label: '/posts', href: '/posts/' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header-inner">
				<a class="site-name" href="/">/goma-room</a>

				<nav class="desktop-nav" aria-label="メインナビゲーション">
					{navigation.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>

				<details class="menu">
					<summary class="menu-toggle">
						<span class="menu-label">メニュー</span>
						<span class="menu-icon" aria-hidden="true">
							<span></span>
							<span></span>
							<span></span>
						</span>
					</summary>
					<nav class="menu-panel" aria-label="モバイルナビゲーション">
						{navigation.map((item) => <a href={item.href}>{item.label}</a>)}
					</nav>
				</details>
			</div>
		</header>

		<div class="site-frame">
			<div class="ambient ambient-left" aria-hidden="true"></div>
			<div class="content-column">
				<main>
					<slot />
				</main>
			</div>
			<div class="ambient ambient-right" aria-hidden="true"></div>
		</div>

		<footer class="site-footer">
			<div class="site-footer-inner">
				<nav class="footer-links" aria-label="関連リンク">
					<a
						href="https://github.com/Yoshi-Tamu"
						target="_blank"
						rel="me noopener noreferrer"
					>github</a>
					<a href="https://astro.build/" target="_blank" rel="noopener noreferrer">astro</a>
					<a href="https://www.cloudflare.com/" target="_blank" rel="noopener noreferrer"
						>cloudflare</a
					>
				</nav>
				<span>2026</span>
			</div>
		</footer>
	</body>
</html>

<script>
	const menus = document.querySelectorAll<HTMLDetailsElement>('.menu');

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Node)) return;

		menus.forEach((menu) => {
			if (menu.open && !menu.contains(event.target)) {
				menu.open = false;
			}
		});
	});

	menus.forEach((menu) => {
		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				menu.open = false;
			});
		});
	});
</script>

<style>
	.site-header,
	.site-footer {
		position: relative;
		z-index: 20;
		background: #111111;
		color: #f7f7f7;
	}

	.site-header {
		border-bottom: 1px solid #2d2d2d;
	}

	.site-header-inner,
	.site-footer-inner {
		width: min(100% - 3rem, 56rem);
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.site-header-inner {
		min-height: 4rem;
	}

	.site-name {
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}

	.desktop-nav,
	.footer-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.desktop-nav {
		font-size: 0.9rem;
	}

	.desktop-nav a,
	.footer-links a {
		color: inherit;
		text-decoration: none;
	}

	.desktop-nav a:hover,
	.desktop-nav a:focus-visible,
	.footer-links a:hover,
	.footer-links a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.site-frame {
		display: grid;
		width: 100%;
		min-width: 0;
		flex: 1;
		grid-template-columns: minmax(0, 1fr) minmax(0, 56rem) minmax(0, 1fr);
		background: #fafafa;
	}

	.content-column {
		min-width: 0;
		background: var(--background);
		border-inline: 1px solid var(--line);
	}

	main {
		width: min(100% - 4rem, 42rem);
		margin-inline: auto;
		padding-block: 4rem 6rem;
	}

	.ambient {
		position: relative;
		min-width: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.ambient::before {
		position: absolute;
		inset: -2rem;
		content: '';
		background-image:
			linear-gradient(to right, rgb(17 17 17 / 0.035) 1px, transparent 1px),
			linear-gradient(to bottom, rgb(17 17 17 / 0.035) 1px, transparent 1px);
		background-size: 2rem 2rem;
	}

	.ambient-left::before {
		animation: grid-drift-left 24s linear infinite;
	}

	.ambient-right::before {
		background-position: 1rem 0.5rem;
		animation: grid-drift-right 29s linear -9s infinite;
	}

	@keyframes grid-drift-left {
		to {
			background-position: 2rem 2rem;
		}
	}

	@keyframes grid-drift-right {
		to {
			background-position: -1rem 2.5rem;
		}
	}

	.site-footer {
		border-top: 1px solid #2d2d2d;
	}

	.site-footer-inner {
		min-height: 3.5rem;
		font-size: 0.78rem;
		color: #bdbdbd;
	}

	.menu {
		position: relative;
		display: none;
	}

	.menu-toggle {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		cursor: pointer;
		list-style: none;
		place-items: center;
	}

	.menu-toggle::-webkit-details-marker {
		display: none;
	}

	.menu-toggle:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	.menu-label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.menu-icon {
		display: grid;
		width: 1.4rem;
		gap: 0.3rem;
	}

	.menu-icon span {
		display: block;
		height: 1px;
		background: currentColor;
	}

	.menu-panel {
		position: absolute;
		top: calc(100% + 0.6rem);
		right: 0;
		z-index: 30;
		display: flex;
		min-width: 10rem;
		padding-block: 0.45rem;
		border: 1px solid #393939;
		background: #171717;
		box-shadow: 0 0.4rem 1.2rem rgb(0 0 0 / 0.14);
		flex-direction: column;
		font-size: 0.9rem;
	}

	.menu-panel a {
		padding: 0.45rem 1rem;
		color: inherit;
		text-decoration: none;
	}

	.menu-panel a:hover,
	.menu-panel a:focus-visible {
		background: #292929;
	}

	@media (max-width: 64rem) {
		.site-frame {
			display: block;
		}

		.ambient {
			display: none;
		}

		.content-column {
			min-height: 100%;
			border-inline: 0;
		}
	}

	@media (max-width: 42rem) {
		.site-header-inner,
		.site-footer-inner {
			width: min(100% - 2rem, 56rem);
		}

		.desktop-nav {
			display: none;
		}

		.menu {
			display: block;
		}

		main {
			width: min(100% - 2rem, 42rem);
			padding-block: 3rem 4rem;
		}

		.site-footer-inner {
			padding-block: 0.85rem;
			align-items: flex-start;
			flex-direction: column;
			gap: 0.4rem;
		}

		.footer-links {
			gap: 1rem;
			flex-wrap: wrap;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ambient::before {
			animation: none;
		}
	}
</style>

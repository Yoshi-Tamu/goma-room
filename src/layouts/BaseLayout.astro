---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'ごまの制作物と日々の記録を置く個人サイトです。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header-inner">
				<a class="site-name" href="/">ごま部屋</a>

				<details class="menu">
					<summary class="menu-toggle">
						<span class="menu-label">メニュー</span>
						<span class="menu-icon" aria-hidden="true">
							<span></span>
							<span></span>
							<span></span>
						</span>
					</summary>
					<nav class="menu-panel" aria-label="メインナビゲーション">
						<a href="/">/Home</a>
						<a href="/now/">/Now</a>
						<a href="/#works-heading">/Works</a>
						<a href="/posts/">/Posts</a>
						<a href="/tils/">/Til</a>
						<a href="/#links-heading">/Links</a>
					</nav>
				</details>
			</div>
		</header>

		<div class="page">
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>

<script>
	const menus = document.querySelectorAll<HTMLDetailsElement>('.menu');

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Node)) return;

		menus.forEach((menu) => {
			if (menu.open && !menu.contains(event.target)) {
				menu.open = false;
			}
		});
	});

	menus.forEach((menu) => {
		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				menu.open = false;
			});
		});
	});
</script>

<style>
	.page {
		width: min(100% - 2.5rem, 42rem);
		margin-inline: auto;
		padding-block: 4rem 6rem;
	}

	.site-header {
		background: #f3f3f3;
		border-bottom: 1px solid var(--line);
	}

	.site-header-inner {
		width: min(100% - 2.5rem, 42rem);
		min-height: 4rem;
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.site-name {
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}

	.menu {
		position: relative;
	}

	.menu-toggle {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		cursor: pointer;
		list-style: none;
		place-items: center;
	}

	.menu-toggle::-webkit-details-marker {
		display: none;
	}

	.menu-toggle:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	.menu-label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.menu-icon {
		display: grid;
		width: 1.4rem;
		gap: 0.3rem;
	}

	.menu-icon span {
		display: block;
		height: 1px;
		background: currentColor;
	}

	.menu-panel {
		position: absolute;
		top: calc(100% + 0.6rem);
		right: 0;
		z-index: 10;
		display: flex;
		min-width: 10rem;
		padding-block: 0.45rem;
		border: 1px solid var(--line);
		background: var(--background);
		flex-direction: column;
		font-size: 0.9rem;
	}

	.menu-panel a {
		padding: 0.45rem 1rem;
		text-decoration: none;
	}

	.menu-panel a:hover,
	.menu-panel a:focus-visible {
		background: #f3f3f3;
	}

	@media (max-width: 36rem) {
		.page {
			width: min(100% - 2rem, 42rem);
			padding-block: 3rem 4rem;
		}

		.site-header-inner {
			width: min(100% - 2rem, 42rem);
		}
	}
</style>

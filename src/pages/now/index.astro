---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="/now | ごま部屋" description="ごまが現在取り組んでいることの記録です。">
	<header class="page-heading">
		<h1>/now</h1>
		<p>今やっていること</p>
	</header>
	<time datetime="2026-08-28">2026-08-28</time>
	<ul>
		<li>ごま部屋を育てる</li>
		<li>Git / GitHubをちゃんと覚える</li>
		<li>Web技術をいろいろ試す</li>
	</ul>
</BaseLayout>

<style>
	.page-heading {
		margin-bottom: 2.5rem;
	}

	h1 {
		margin: 0 0 0.5rem;
		font-size: 2rem;
		letter-spacing: -0.03em;
	}

	p {
		margin: 0;
		color: var(--muted);
	}

	time {
		color: var(--muted);
		font-size: 0.875rem;
	}

	ul {
		margin: 1rem 0 0;
		padding-left: 1.25rem;
	}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import TilList from '../components/TilList.astro';
import { getCollection } from 'astro:content';
import { works } from '../data/works';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const tils = (await getCollection('tils')).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
	title="ごま部屋"
	description="ごまの制作物と日々の記録を置く個人サイトです。"
	isHome
>
	<section slot="hero" class="home-hero" data-home-hero aria-labelledby="hero-title">
		<div class="hero-copy">
			<h1 id="hero-title">ごま部屋</h1>
			<p>高専生。Webとかいろいろ作っています。勉強中。</p>
		</div>
		<span class="scroll-cue" aria-hidden="true">scroll</span>
	</section>

	<section aria-labelledby="now-heading">
		<div class="section-heading">
			<h2 id="now-heading">/now</h2>
			<a href="/now/">すべて見る</a>
		</div>
		<p class="section-note">ごま部屋を育てています...</p>
	</section>

	<section aria-labelledby="works-heading">
		<h2 id="works-heading">/works</h2>
		<ul class="item-list">
			{works.map((work) => (
				<li>
					{work.url ? <a href={work.url}>{work.title}</a> : <span>{work.title}</span>}
					<span class="description"> — {work.description}</span>
				</li>
			))}
		</ul>
	</section>

	<section aria-labelledby="posts-heading">
		<div class="section-heading">
			<h2 id="posts-heading">/posts</h2>
			<a href="/posts/">すべて見る</a>
		</div>
		<PostList posts={posts.slice(0, 5)} />
	</section>

	<section aria-labelledby="tils-heading">
		<div class="section-heading">
			<h2 id="tils-heading">/til</h2>
			<a href="/til/">すべて見る</a>
		</div>
		<TilList tils={tils.slice(0, 5)} />
	</section>

	<section aria-labelledby="links-heading">
		<h2 id="links-heading">/links</h2>
		<ul class="item-list">
			<li>
				<a
					href="https://github.com/Yoshi-Tamu"
					target="_blank"
					rel="me noopener noreferrer"
				>GitHub</a>
			</li>
		</ul>
	</section>
</BaseLayout>

<style>
	.home-hero {
		position: relative;
		display: grid;
		min-height: 100svh;
		padding: clamp(2rem, 7vw, 6rem);
		background: #000;
		color: #fff;
		place-items: center;
	}

	.hero-copy {
		width: min(100%, 42rem);
	}

	.hero-copy h1 {
		margin: 0;
		font-size: clamp(3rem, 10vw, 6rem);
		font-weight: 650;
		letter-spacing: -0.055em;
		line-height: 1.05;
		animation: hero-enter 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-copy p {
		margin: 1.25rem 0 0;
		color: #bdbdbd;
		font-size: clamp(0.95rem, 2vw, 1.05rem);
		animation: hero-enter 800ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both;
	}

	.scroll-cue {
		position: absolute;
		bottom: 1.75rem;
		left: 50%;
		color: #858585;
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		transform: translateX(-50%);
		animation: hero-enter 800ms ease 350ms both;
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	section + section {
		margin-top: 3.5rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.1rem;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.section-heading a {
		font-size: 0.875rem;
	}

	.section-note {
		margin: 0;
		color: var(--muted);
	}

	.item-list {
		margin: 0;
		padding-left: 1.25rem;
	}

	.item-list li + li {
		margin-top: 0.6rem;
	}

	.description {
		color: var(--muted);
	}

	@media (max-width: 36rem) {
		section + section {
			margin-top: 2.75rem;
		}

		.description {
			display: block;
			margin-top: 0.15rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-copy h1,
		.hero-copy p,
		.scroll-cue {
			animation: none;
		}
	}
</style>

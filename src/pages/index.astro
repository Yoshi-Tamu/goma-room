---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import TilList from '../components/TilList.astro';
import { getCollection } from 'astro:content';
import { works } from '../data/works';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const tils = (await getCollection('tils')).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout title="ごま部屋" description="ごまの制作物と日々の記録を置く個人サイトです。">
	<header class="intro">
		<h1>ごま部屋</h1>
		<p>高専生。Webとかいろいろ作っています。勉強中。</p>
	</header>

	<section aria-labelledby="now-heading">
		<div class="section-heading">
			<h2 id="now-heading">/Now</h2><br>
			ごま部屋を育てています...<br>
			<a href="/now/">すべて見る</a>
		</div>
	</section>

	<section aria-labelledby="works-heading">
		<h2 id="works-heading">/Works</h2>
		<ul class="item-list">
			{works.map((work) => (
				<li>
					{work.url ? <a href={work.url}>{work.title}</a> : <span>{work.title}</span>}
					<span class="description"> — {work.description}</span>
				</li>
			))}
		</ul>
	</section>

	<section aria-labelledby="posts-heading">
		<div class="section-heading">
			<h2 id="posts-heading">/Posts</h2>
			<a href="/posts/">すべて見る</a>
		</div>
		<PostList posts={posts.slice(0, 5)} />
	</section>

	<section aria-labelledby="tils-heading">
		<div class="section-heading">
			<h2 id="tils-heading">/Til</h2>
			<a href="/tils/">すべて見る</a>
		</div>
		<TilList tils={tils.slice(0, 5)} />
	</section>

	<section aria-labelledby="links-heading">
		<h2 id="links-heading">/Links</h2>
		<ul class="item-list">
			<li>
				<a
					href="https://github.com/Yoshi-Tamu"
					target="_blank"
					rel="me noopener noreferrer"
				>GitHub</a>
			</li>
		</ul>
	</section>
</BaseLayout>

<style>
	.intro {
		margin-bottom: 4rem;
	}

	.intro h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2rem, 7vw, 2.75rem);
		letter-spacing: -0.04em;
	}

	.intro p {
		margin: 0;
		color: var(--muted);
	}

	section + section {
		margin-top: 3.5rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.1rem;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.section-heading a {
		font-size: 0.875rem;
	}

	.item-list {
		margin: 0;
		padding-left: 1.25rem;
	}

	.item-list li + li {
		margin-top: 0.6rem;
	}

	.description {
		color: var(--muted);
	}

	@media (max-width: 36rem) {
		.intro {
			margin-bottom: 3rem;
		}

		section + section {
			margin-top: 2.75rem;
		}

		.description {
			display: block;
			margin-top: 0.15rem;
		}
	}
</style>

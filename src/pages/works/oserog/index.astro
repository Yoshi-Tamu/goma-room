---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="オセローグ | ごま"
	description="爆破と侵食を使って遊ぶ、ローカル2人対戦のWebオセロです。"
>
	<article class="work-page">
		<header class="work-header">
			<p class="back-link"><a href="/#works-heading">← 作品一覧へ戻る</a></p>
			<h1>オセローグ</h1>
			<p>爆破と侵食を使って盤面を動かす、同じ端末で遊べる2人対戦オセロです。</p>
		</header>

		<section class="game" aria-labelledby="game-heading">
			<h2 id="game-heading" class="visually-hidden">オセローグ対局</h2>

			<div class="scoreboard" aria-label="対局状況">
				<div>
					<span class="score-label">手番</span>
					<strong id="turn-label">黒</strong>
				</div>
				<div>
					<span class="score-label">黒</span>
					<strong id="black-score">2</strong>
				</div>
				<div>
					<span class="score-label">白</span>
					<strong id="white-score">2</strong>
				</div>
				<div>
					<span class="score-label">着手</span>
					<strong id="move-count">0手完了</strong>
				</div>
			</div>
			<p id="special-status" class="special-status">
				黒：爆破3・侵食3 ／ 白：爆破3・侵食3。爆破は9手目から（あと8手）
			</p>

			<div class="game-stage">
				<div id="game-controls">
					<fieldset class="mode-controls">
						<legend>この手で使う効果</legend>
						<div class="mode-buttons">
							<button type="button" data-mode="normal" aria-pressed="true">通常</button>
							<button type="button" data-mode="blast" aria-pressed="false" disabled>
								爆破（9手目から・あと8手）
							</button>
							<button type="button" data-mode="erosion" aria-pressed="false">侵食（残り3）</button>
						</div>
						<p id="mode-help">通常のオセロと同じように石を置きます。</p>
					</fieldset>

					<div id="board" class="board" aria-label="8×8のオセローグ盤面"></div>

					<p id="game-message" class="game-message">黒が先手です。</p>
					<p id="result" class="result" hidden></p>
				</div>

				<section
					id="handoff-overlay"
					class="handoff-overlay"
					role="dialog"
					aria-modal="true"
					aria-labelledby="overlay-title"
				>
					<div class="overlay-content">
						<h3 id="overlay-title">オセローグ</h3>
						<p id="overlay-message">黒が先手です。準備ができたら始めてください。</p>
						<button id="overlay-confirm" type="button">ゲームを始める</button>
					</div>
				</section>
			</div>

			<div class="game-actions">
				<button id="reset-game" type="button">もう一度遊ぶ</button>
				<a href="/#works-heading">作品一覧へ戻る</a>
			</div>
			<p id="announcement" class="visually-hidden" aria-live="polite" aria-atomic="true"></p>
		</section>

		<section class="rules" aria-labelledby="rules-heading">
			<h2 id="rules-heading">遊び方</h2>
			<p>
				標準の8×8オセロと同じ初期配置で、黒から始めます。相手の石を挟めるマスだけに置けます。
				置ける場所がなければ自動でパスし、両者とも置けなくなった時点で石の多い方が勝ちです。
			</p>
			<dl>
				<div>
					<dt>爆破（9手目から、各3回）</dt>
					<dd>
						対局全体の9手目から使用できます。合法手を選び、周囲8マスにある相手の石だけを消してから
						自分の石を置きます。自分の石は消えず、爆破手では通常の反転も起こりません。
					</dd>
				</div>
				<div>
					<dt>侵食（各3回）</dt>
					<dd>
						通常どおり配置・反転した後、周囲8マスにある石を自分の色にします。
						さらに、その各石を起点に挟めた石を一度だけ反転します。
					</dd>
				</div>
			</dl>
			<p>
				特殊手はどちらか一方だけを選べます。盤面に「＋」が表示されているマスが、現在置ける場所です。
			</p>
		</section>

		<section class="improvements" aria-labelledby="improvements-heading">
			<h2 id="improvements-heading">Web版での改良</h2>
			<ul>
				<li>Unity版のルールを、インストール不要のWebゲームとして再構成</li>
				<li>爆破を9手目から解禁し、周囲の相手石だけを消すルールへ調整</li>
				<li>侵食効果が重複して適用される問題を修正</li>
				<li>爆破と侵食を同時に選べないよう、特殊モードを排他化</li>
				<li>再戦時に盤面・手番・残数が確実に初期化されるよう修正</li>
			</ul>
		</section>
	</article>
</BaseLayout>

<script>
	import {
		countDiscs,
		createInitialGameState,
		getLegalMoves,
		playMove,
		type GameState,
		type MoveMode,
		type Player,
	} from '../../../lib/oserog';

	const boardElement = document.querySelector<HTMLDivElement>('#board')!;
	const gameControls = document.querySelector<HTMLDivElement>('#game-controls')!;
	const turnLabel = document.querySelector<HTMLElement>('#turn-label')!;
	const blackScore = document.querySelector<HTMLElement>('#black-score')!;
	const whiteScore = document.querySelector<HTMLElement>('#white-score')!;
	const moveCount = document.querySelector<HTMLElement>('#move-count')!;
	const specialStatus = document.querySelector<HTMLParagraphElement>('#special-status')!;
	const gameMessage = document.querySelector<HTMLParagraphElement>('#game-message')!;
	const result = document.querySelector<HTMLParagraphElement>('#result')!;
	const announcement = document.querySelector<HTMLParagraphElement>('#announcement')!;
	const modeHelp = document.querySelector<HTMLParagraphElement>('#mode-help')!;
	const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mode]'));
	const overlay = document.querySelector<HTMLElement>('#handoff-overlay')!;
	const overlayTitle = document.querySelector<HTMLElement>('#overlay-title')!;
	const overlayMessage = document.querySelector<HTMLParagraphElement>('#overlay-message')!;
	const overlayConfirm = document.querySelector<HTMLButtonElement>('#overlay-confirm')!;
	const resetButton = document.querySelector<HTMLButtonElement>('#reset-game')!;

	const playerName = (player: Player) => (player === 'black' ? '黒' : '白');
	const modeName: Record<MoveMode, string> = {
		normal: '通常',
		blast: '爆破',
		erosion: '侵食',
	};
	const modeDescription: Record<MoveMode, string> = {
		normal: '通常のオセロと同じように石を置きます。',
		blast: '周囲8マスの石を消して配置します。通常の反転は行いません。',
		erosion: '通常反転の後、周囲の石を自色化し、追加反転を一度判定します。',
	};

	let state: GameState = createInitialGameState();
	let selectedMode: MoveMode = 'normal';

	function positionKey(row: number, col: number) {
		return `${row},${col}`;
	}

	function coordinateName(row: number, col: number) {
		return `${String.fromCharCode(65 + col)}${row + 1}`;
	}

	function cellLabel(row: number, col: number, isLegal: boolean) {
		const cell = state.board[row][col];
		const status = cell === null ? '空き' : `${playerName(cell)}の石`;
		return `${coordinateName(row, col)}、${status}${isLegal ? '、合法手' : ''}`;
	}

	function renderBoard() {
		const legalMoves = getLegalMoves(state.board, state.currentPlayer);
		const legalKeys = new Set(legalMoves.map(({ row, col }) => positionKey(row, col)));
		boardElement.replaceChildren();
		boardElement.setAttribute(
			'aria-label',
			`8×8のオセローグ盤面、${playerName(state.currentPlayer)}の手番`,
		);

		for (let row = 0; row < 8; row += 1) {
			for (let col = 0; col < 8; col += 1) {
				const cell = state.board[row][col];
				const isLegal = legalKeys.has(positionKey(row, col));
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'cell';
				button.dataset.row = String(row);
				button.dataset.col = String(col);
				button.setAttribute('aria-label', cellLabel(row, col, isLegal));
				button.setAttribute('aria-disabled', String(!isLegal || state.gameOver));
				if (isLegal) button.classList.add('is-legal');

				if (cell !== null) {
					const disc = document.createElement('span');
					disc.className = `disc ${cell}`;
					disc.setAttribute('aria-hidden', 'true');
					const discText = document.createElement('span');
					discText.className = 'disc-text';
					discText.textContent = playerName(cell);
					disc.append(discText);
					button.append(disc);
				} else if (isLegal) {
					const marker = document.createElement('span');
					marker.className = 'legal-marker';
					marker.setAttribute('aria-hidden', 'true');
					marker.textContent = '＋';
					button.append(marker);
				}

				button.addEventListener('click', () => handleCellClick(row, col, isLegal));
				button.addEventListener('keydown', handleBoardKeydown);
				boardElement.append(button);
			}
		}
	}

	function renderStatus() {
		const score = countDiscs(state.board);
		turnLabel.textContent = state.gameOver ? '終了' : playerName(state.currentPlayer);
		blackScore.textContent = String(score.black);
		whiteScore.textContent = String(score.white);
		moveCount.textContent = `${state.completedMoves}手完了`;
		const movesUntilBlast = Math.max(0, 8 - state.completedMoves);
		const blastTiming =
			movesUntilBlast > 0
				? `爆破は9手目から（あと${movesUntilBlast}手）`
				: '爆破使用可能';
		specialStatus.textContent =
			`黒：爆破${state.specials.black.blast}・侵食${state.specials.black.erosion}` +
			` ／ 白：爆破${state.specials.white.blast}・侵食${state.specials.white.erosion}。${blastTiming}`;

		for (const button of modeButtons) {
			const mode = button.dataset.mode as MoveMode;
			const remaining = mode === 'normal' ? null : state.specials[state.currentPlayer][mode];
			const blastLocked = mode === 'blast' && state.completedMoves < 8;
			button.textContent =
				mode === 'blast' && blastLocked
					? `爆破（9手目から・あと${8 - state.completedMoves}手）`
					: remaining === null
						? '通常'
						: `${modeName[mode]}（残り${remaining}）`;
			button.setAttribute('aria-pressed', String(mode === selectedMode));
			button.disabled =
				state.gameOver || blastLocked || (remaining !== null && remaining <= 0);
		}
		modeHelp.textContent = modeDescription[selectedMode];
	}

	function render() {
		renderStatus();
		renderBoard();
	}

	function showOverlay(title: string, message: string, buttonText: string) {
		overlayTitle.textContent = title;
		overlayMessage.textContent = message;
		overlayConfirm.textContent = buttonText;
		overlay.hidden = false;
		gameControls.inert = true;
		requestAnimationFrame(() => overlayConfirm.focus());
	}

	function hideOverlay() {
		overlay.hidden = true;
		gameControls.inert = false;
		announcement.textContent = state.gameOver
			? '対局結果を表示しました。'
			: `${playerName(state.currentPlayer)}の手番です。`;
		const firstLegal = boardElement.querySelector<HTMLButtonElement>('.is-legal');
		firstLegal?.focus();
	}

	function handleCellClick(row: number, col: number, isLegal: boolean) {
		if (state.gameOver) {
			announcement.textContent = '対局は終了しています。もう一度遊ぶを選んでください。';
			return;
		}
		if (!isLegal) {
			announcement.textContent = `${coordinateName(row, col)}には置けません。＋のあるマスを選んでください。`;
			return;
		}

		const movedPlayer = state.currentPlayer;
		const usedMode = selectedMode;
		try {
			const move = playMove(state, row, col, selectedMode);
			state = move.state;
			selectedMode = 'normal';
			render();

			const placedMessage = `${playerName(movedPlayer)}が${coordinateName(row, col)}に${modeName[usedMode]}で置きました。`;
			if (state.gameOver) {
				const score = countDiscs(state.board);
				const winnerText =
					state.winner === 'draw' ? '引き分けです。' : `${playerName(state.winner!)}の勝ちです。`;
				const finalMessage = `${placedMessage} 対局終了。黒${score.black}、白${score.white}。${winnerText}`;
				gameMessage.textContent = '両者とも置ける場所がないため、対局終了です。';
				result.hidden = false;
				result.textContent = `最終結果：黒 ${score.black} — ${score.white} 白。${winnerText}`;
				announcement.textContent = finalMessage;
				showOverlay('対局終了', `黒 ${score.black} — ${score.white} 白。${winnerText}`, '盤面と結果を見る');
			} else if (move.passed !== null) {
				const passMessage = `${playerName(move.passed)}は置ける場所がないためパスしました。${playerName(state.currentPlayer)}の手番が続きます。`;
				gameMessage.textContent = passMessage;
				announcement.textContent = `${placedMessage} ${passMessage}`;
				showOverlay('パス', passMessage, '続ける');
			} else {
				const nextMessage = `${playerName(state.currentPlayer)}の手番です。端末を次のプレイヤーに渡してください。`;
				gameMessage.textContent = nextMessage;
				announcement.textContent = `${placedMessage} ${nextMessage}`;
				showOverlay(`${playerName(state.currentPlayer)}の手番`, nextMessage, '盤面を表示');
			}
		} catch (error) {
			announcement.textContent = error instanceof Error ? error.message : '手を処理できませんでした。';
		}
	}

	function handleBoardKeydown(event: KeyboardEvent) {
		const current = event.currentTarget as HTMLButtonElement;
		const row = Number(current.dataset.row);
		const col = Number(current.dataset.col);
		const movement: Record<string, [number, number]> = {
			ArrowUp: [-1, 0],
			ArrowDown: [1, 0],
			ArrowLeft: [0, -1],
			ArrowRight: [0, 1],
		};
		const delta = movement[event.key];
		if (!delta) return;
		event.preventDefault();
		const nextRow = Math.min(7, Math.max(0, row + delta[0]));
		const nextCol = Math.min(7, Math.max(0, col + delta[1]));
		boardElement
			.querySelector<HTMLButtonElement>(`[data-row="${nextRow}"][data-col="${nextCol}"]`)
			?.focus();
	}

	for (const button of modeButtons) {
		button.addEventListener('click', () => {
			selectedMode = button.dataset.mode as MoveMode;
			renderStatus();
			announcement.textContent = `${modeName[selectedMode]}を選びました。${modeDescription[selectedMode]}`;
		});
	}

	overlayConfirm.addEventListener('click', hideOverlay);
	resetButton.addEventListener('click', () => {
		state = createInitialGameState();
		selectedMode = 'normal';
		result.hidden = true;
		result.textContent = '';
		gameMessage.textContent = '黒が先手です。';
		render();
		announcement.textContent = '盤面を初期化しました。黒が先手です。';
		showOverlay('オセローグ', '黒が先手です。準備ができたら始めてください。', 'ゲームを始める');
	});

	render();
	showOverlay('オセローグ', '黒が先手です。準備ができたら始めてください。', 'ゲームを始める');
</script>

<style>
	.work-header {
		margin-bottom: 3rem;
	}

	.back-link {
		margin: 0 0 1.5rem;
		font-size: 0.9rem;
	}

	h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2rem, 8vw, 2.75rem);
		letter-spacing: -0.04em;
	}

	.work-header > p:last-child {
		margin: 0;
		color: var(--muted);
	}

	.game {
		margin-bottom: 4.5rem;
	}

	.scoreboard {
		display: grid;
		grid-template-columns: 1.4fr 0.8fr 0.8fr 1.4fr;
		margin-bottom: 1.5rem;
		border-block: 1px solid var(--line);
	}

	.scoreboard > div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.7rem 0.9rem;
	}

	.scoreboard > div + div {
		border-left: 1px solid var(--line);
	}

	.score-label {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.special-status {
		margin: -0.75rem 0 1.5rem;
		color: var(--muted);
		font-size: 0.85rem;
		text-align: right;
	}

	.game-stage {
		position: relative;
	}

	.mode-controls {
		margin: 0 0 1.25rem;
		padding: 0;
		border: 0;
	}

	.mode-controls legend {
		margin-bottom: 0.65rem;
		font-weight: 700;
	}

	.mode-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	button {
		font: inherit;
	}

	.mode-buttons button,
	.game-actions button,
	.overlay-content button {
		padding: 0.55rem 0.85rem;
		border: 1px solid var(--text);
		border-radius: 0;
		background: var(--background);
		color: var(--text);
		cursor: pointer;
	}

	.mode-buttons button[aria-pressed='true'],
	.overlay-content button {
		background: var(--text);
		color: var(--background);
	}

	.mode-buttons button:disabled {
		cursor: not-allowed;
		opacity: 0.45;
	}

	.mode-buttons button:focus-visible,
	.game-actions button:focus-visible,
	.overlay-content button:focus-visible,
	.cell:focus-visible {
		outline: 3px solid #2463a8;
		outline-offset: 2px;
	}

	#mode-help {
		margin: 0.65rem 0 0;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.board {
		display: grid;
		grid-template-columns: repeat(8, minmax(0, 1fr));
		grid-template-rows: repeat(8, minmax(0, 1fr));
		width: min(100%, 34rem);
		aspect-ratio: 1 / 1;
		box-sizing: border-box;
		margin-inline: auto;
		padding: 2px;
		gap: 1px;
		border: 1px solid var(--text);
		background: #777;
	}

	:global(.cell) {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		aspect-ratio: 1 / 1;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: #f1f1ec;
		color: var(--text);
		font: inherit;
		cursor: default;
	}

	:global(.cell.is-legal) {
		cursor: pointer;
	}

	:global(.cell.is-legal:hover) {
		background: #e3e3dc;
	}

	:global(.disc) {
		display: grid;
		place-items: center;
		width: 76%;
		aspect-ratio: 1;
		border: 2px solid var(--text);
		border-radius: 50%;
		font-size: clamp(0.55rem, 2vw, 0.75rem);
		font-weight: 700;
		line-height: 1;
	}

	:global(.disc.black) {
		background: #191919;
		color: white;
	}

	:global(.disc.white) {
		background: white;
		color: #191919;
	}

	:global(.legal-marker) {
		display: grid;
		place-items: center;
		width: 52%;
		aspect-ratio: 1;
		border: 1px dashed #555;
		border-radius: 50%;
		font-size: clamp(0.85rem, 3vw, 1.2rem);
		font-weight: 700;
		line-height: 1;
	}

	.game-message,
	.result {
		margin: 1rem 0 0;
	}

	.game-message {
		color: var(--muted);
	}

	.result {
		font-weight: 700;
	}

	.handoff-overlay {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 1.5rem;
		background: rgb(255 255 255 / 96%);
		border: 1px solid var(--line);
		z-index: 2;
	}

	.handoff-overlay[hidden] {
		display: none;
	}

	.overlay-content {
		width: min(100%, 25rem);
		text-align: center;
	}

	.overlay-content h3 {
		margin: 0 0 0.75rem;
		font-size: 1.4rem;
	}

	.overlay-content p {
		margin: 0 0 1.25rem;
	}

	.game-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.5rem;
	}

	.rules,
	.improvements {
		margin-top: 4rem;
	}

	.rules h2,
	.improvements h2 {
		margin: 0 0 1rem;
		font-size: 1.25rem;
	}

	.rules dl {
		margin: 2rem 0;
	}

	.rules dl > div {
		padding-block: 1rem;
		border-block: 1px solid var(--line);
	}

	.rules dl > div + div {
		border-top: 0;
	}

	.rules dt {
		font-weight: 700;
	}

	.rules dd {
		margin: 0.35rem 0 0;
		color: var(--muted);
	}

	.improvements ul {
		padding-left: 1.25rem;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 36rem) {
		.work-header {
			margin-bottom: 2.5rem;
		}

		.scoreboard > div {
			flex-direction: column;
			gap: 0;
		}

		.mode-buttons {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
		}

		.mode-buttons button {
			padding-inline: 0.35rem;
			font-size: 0.82rem;
		}

		.handoff-overlay {
			padding: 1rem;
		}
	}
</style>
